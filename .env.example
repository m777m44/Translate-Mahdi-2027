# --- AI translation (optional; app falls back to the offline engine) ---
GEMINI_API_KEY=

# --- Firebase cloud sync (optional; history backup tied to the account) ---
# Get these from: Firebase console → Project settings → Your apps → Web app.
# These are PUBLIC web keys; Firestore security rules protect the data.
# Leave blank to run in local-only mode (no cloud sync).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
