{
  "name": "mahdi-translate-pro",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --env-file-if-exists=.env dist/server.cjs",
    "lint": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && node -e \"require('fs').rmSync('dist/downloads',{recursive:true,force:true})\" && cap sync android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "verify:themes": "tsx scripts/verify-themes.ts",
    "check": "npm run verify && npm run lint && npm run build",
    "verify:app": "tsx scripts/verify-app-render.tsx",
    "verify": "npm run verify:themes && npm run verify:app"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^1.39.0",
    "@huggingface/transformers": "^3.8.1",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.563.0",
    "onnxruntime-web": "^1.22.0-dev.20250409-89f8206ba4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
